# Скопируйте этот файл в .env и поменяйте значения перед запуском в продакшене

# Секрет для подписи токенов входа. Обязательно замените на длинную случайную строку!
JWT_SECRET=change-me-to-a-long-random-string

# Порт, на котором запустится сервер (платформы вроде Render подставят свой автоматически)
PORT=3000
